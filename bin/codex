#!/usr/bin/env bash
# Runs Codex CLI in an isolated container.
# Engine: Apple `container` on macOS, Podman on Linux.
set -euo pipefail

case "$(uname -s)" in
  Darwin) ENGINE=container ;;
  Linux)  if command -v podman >/dev/null 2>&1; then
            ENGINE=podman
          else
            echo "No supported container engine found. Supported: Apple container (macOS), Podman (Linux). Docker is not supported." >&2; exit 1
          fi
          ;;
  *) echo "Unsupported OS: $(uname -s)" >&2; exit 1 ;;
esac

HOME_DIR="$HOME/.cli-tools/codex-home"
mkdir -p "$HOME_DIR"

# Mount the project at a path unique to this host folder, so tools that keep
# per-project state by path (sessions, trust, memory) don't mix projects.
HOST_DIR="$(pwd -P)"
if command -v sha256sum >/dev/null 2>&1; then
  HASH="$(printf '%s' "$HOST_DIR" | sha256sum | cut -c1-12)"
else
  HASH="$(printf '%s' "$HOST_DIR" | shasum -a 256 | cut -c1-12)"
fi
NAME="$(basename "$HOST_DIR")"
WORKDIR="/workspace/$HASH/${NAME//[^A-Za-z0-9._-]/_}"

# Bare -e KEY: the engine forwards the host's own value and skips unset ones,
# so secret values never appear in the command line.
ENV_ARGS=()
for KEY in TERM COLORTERM OPENAI_API_KEY; do
  ENV_ARGS+=(-e "$KEY")
done

# Linux hardening (Podman): keep just the capabilities needed for
# file handling and apt-get; Apple `container` runs each container in its
# own VM instead.
SEC_ARGS=()
RUN_ARGS=()

if [ "$ENGINE" != container ]; then
  SEC_ARGS+=(--security-opt no-new-privileges --cap-drop=ALL --cap-add=CHOWN,DAC_OVERRIDE,FOWNER,FSETID,SETUID,SETGID)
else
  RUN_ARGS+=(--progress none)
fi

"$ENGINE" run --rm -it \
  "${RUN_ARGS[@]+"${RUN_ARGS[@]}"}" \
  -v "$HOST_DIR":"$WORKDIR" -w "$WORKDIR" \
  -v "$HOME_DIR":/root \
  "${ENV_ARGS[@]+"${ENV_ARGS[@]}"}" \
  "${SEC_ARGS[@]+"${SEC_ARGS[@]}"}" \
  cli-tools-codex "$@"
