#!/usr/bin/env bash
# Deprecated: builds the images and installs the compiled binary via
# `cli-tools build`. Kept until the busybox-launcher migration cutover
# (issue #41); run `cli-tools build` directly instead.
set -euo pipefail
if command -v cli-tools >/dev/null 2>&1; then
  exec cli-tools build "$@"
fi
echo "error: cli-tools is not installed. Build and install it first:" >&2
echo "  go build -o \"\$HOME/.local/bin/cli-tools\" ./cmd/cli-tools" >&2
echo "  cli-tools build" >&2
exit 1
